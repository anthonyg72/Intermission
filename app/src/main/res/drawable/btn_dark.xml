<?xml version="1.0" encoding="utf-8"?>
<!-- Near-black fill with a dim red edge: legible in a dark theater without
     throwing light. Deliberately no ripple/highlight color. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0D0505" />
    <stroke android:width="1dp" android:color="#6E2019" />
    <corners android:radius="22dp" />
    <padding android:left="14dp" android:top="9dp" android:right="14dp" android:bottom="9dp" />
</shape>
